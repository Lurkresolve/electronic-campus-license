    border: 1px solid rgb(200, 200, 250);
}

.ace-sqlserver .ace_meta.ace_tag {
    color: #0000FF;
}

.ace-sqlserver .ace_string.ace_regex {
    color: #FF0000;
}

.ace-sqlserver .ace_string {
    color: #FF0000;
}

.ace-sqlserver .ace_entity.ace_other.ace_attribute-name {
    color: #994409;
}

